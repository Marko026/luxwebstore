# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Generate with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL used by the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional, local dev only: `npm run db:seed` creates this User for sign-in checks (use an @example.test address).
TEST_USER_EMAIL=pera@gmail.com
TEST_USER_PASSWORD=peric123456